---
export interface Props {
  size?: 'sm' | 'md' | 'lg';
  variant?: 'primary' | 'gradient' | 'outline' | 'white' | 'warm';
  class?: string;
}

const { size = 'md', variant = 'primary', class: className = '' } = Astro.props;

const sizeClasses = {
  sm: 'px-5 py-2.5 text-sm',
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg',
};

const variantClasses = {
  primary: 'bg-primary-600 text-white hover:bg-primary-700 shadow-lg hover:shadow-xl hover:shadow-primary-500/25',
  gradient: 'bg-primary-600 text-white shadow-lg hover:shadow-xl hover:shadow-primary-500/30',
  outline: 'bg-transparent text-primary-600 border-2 border-primary-600 hover:bg-primary-600 hover:text-white',
  white: 'bg-white text-primary-700 hover:bg-primary-50 shadow-lg hover:shadow-xl',
  warm: 'bg-gradient-to-r from-convivencia-500 to-convivencia-600 text-white shadow-lg hover:shadow-xl hover:shadow-convivencia-500/25',
};
---

<button
  type="button"
  onclick="handleCTAClick()"
  class:list={[
    'btn inline-flex items-center justify-center gap-2 font-semibold rounded-full cursor-pointer',
    'transition-all duration-200 ease-out-quart',
    'min-h-[44px] min-w-[44px]',
    'active:scale-[0.98] hover:-translate-y-0.5',
    sizeClasses[size],
    variantClasses[variant],
    className,
  ]}
  data-umami-event="cta-diagnostico"
>
  Diagnóstico gratuito
  <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
  </svg>
</button>

<script>
  // Función inteligente para el CTA: scroll en /contacto, modal en otras páginas
  (window as any).handleCTAClick = () => {
    // Si estamos en la página de contacto, hacer scroll al formulario
    if (window.location.pathname === '/contacto') {
      const contactForm = document.getElementById('contact-form-wrapper');
      if (contactForm) {
        contactForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }
    }
    
    // Si estamos en mobile y el menú está abierto, cerrarlo primero
    const mobileMenu = document.getElementById('mobile-menu');
    if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
      mobileMenu.classList.add('hidden');
      // Restaurar el ícono del menú
      const menuIconOpen = document.getElementById('menu-icon-open');
      const menuIconClose = document.getElementById('menu-icon-close');
      if (menuIconOpen) menuIconOpen.classList.remove('hidden');
      if (menuIconClose) menuIconClose.classList.add('hidden');
      // Restaurar aria-expanded
      const menuToggle = document.getElementById('mobile-menu-toggle');
      if (menuToggle) menuToggle.setAttribute('aria-expanded', 'false');
      // Restaurar scroll del body
      document.body.classList.remove('overflow-hidden');
    }
    
    // Abrir el modal
    (window as any).openDiagnosticoModal();
  };
</script>
