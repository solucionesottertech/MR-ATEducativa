---
interface Props {
  isOpen?: boolean;
}

const { isOpen = false } = Astro.props;
---

<div
  id="diagnostico-modal"
  class:list={[
    'fixed inset-0 z-50 flex items-center justify-center p-4',
    'transition-opacity duration-300',
    isOpen ? 'opacity-100 pointer-events-auto' : 'opacity-0 pointer-events-none'
  ]}
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <!-- Backdrop -->
  <div
    class="absolute inset-0 bg-primary-900/60 backdrop-blur-sm"
    onclick="document.getElementById('diagnostico-modal').classList.remove('opacity-100', 'pointer-events-auto'); document.getElementById('diagnostico-modal').classList.add('opacity-0', 'pointer-events-none');"
  ></div>

  <!-- Modal Content -->
  <div class="relative bg-white rounded-2xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
    <!-- Close Button -->
    <button
      onclick="document.getElementById('diagnostico-modal').classList.remove('opacity-100', 'pointer-events-auto'); document.getElementById('diagnostico-modal').classList.add('opacity-0', 'pointer-events-none');"
      class="absolute top-4 right-4 w-8 h-8 flex items-center justify-center rounded-full bg-neutral-100 hover:bg-neutral-200 transition-colors"
      aria-label="Cerrar"
    >
      <svg class="w-5 h-5 text-neutral-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Header -->
    <div class="p-8 pb-0">
      <h2 id="modal-title" class="text-2xl font-heading font-bold text-primary-800 mb-2">
        Diagnóstico gratuito
      </h2>
      <p class="text-neutral-600">
        Completa tus datos y te contactaremos para agendar una conversación inicial.
      </p>
    </div>

    <!-- Form -->
    <form
      action="/enviar.php"
      method="POST"
      class="p-8 space-y-5"
      onsubmit="handleSubmit(event)"
    >
      <input type="hidden" name="form_type" value="diagnostico" />
      <input type="hidden" name="submit_time" id="modal-submit-time" value="" />
      <input type="hidden" name="csrf_token" id="modal-csrf-token" value="" />
      
      <!-- Honeypot anti-bot -->
      <div style="position: absolute; left: -9999px;" aria-hidden="true">
        <input type="text" name="botcheck" tabindex="-1" autocomplete="off" />
      </div>

      <!-- Nombre -->
      <div>
        <label for="modal-nombre" class="block text-sm font-medium text-neutral-700 mb-1.5">
          Nombre completo <span class="text-rosa-500">*</span>
        </label>
        <input
          type="text"
          id="modal-nombre"
          name="nombre"
          required
          class="w-full px-4 py-3 rounded-lg border border-neutral-200 focus:border-primary-600 focus:ring-2 focus:ring-primary-600/20 transition-all outline-none"
          placeholder="Tu nombre"
        />
      </div>

      <!-- Email -->
      <div>
        <label for="modal-email" class="block text-sm font-medium text-neutral-700 mb-1.5">
          Correo electrónico <span class="text-rosa-500">*</span>
        </label>
        <input
          type="email"
          id="modal-email"
          name="email"
          required
          class="w-full px-4 py-3 rounded-lg border border-neutral-200 focus:border-primary-600 focus:ring-2 focus:ring-primary-600/20 transition-all outline-none"
          placeholder="tu@correo.cl"
        />
      </div>

      <!-- Teléfono -->
      <div>
        <label for="modal-telefono" class="block text-sm font-medium text-neutral-700 mb-1.5">
          Teléfono <span class="text-rosa-500">*</span>
        </label>
        <input
          type="tel"
          id="modal-telefono"
          name="telefono"
          required
          class="w-full px-4 py-3 rounded-lg border border-neutral-200 focus:border-primary-600 focus:ring-2 focus:ring-primary-600/20 transition-all outline-none"
          placeholder="+56 9 1234 5678"
        />
      </div>

      <!-- Colegio -->
      <div>
        <label for="modal-colegio" class="block text-sm font-medium text-neutral-700 mb-1.5">
          Nombre del establecimiento <span class="text-rosa-500">*</span>
        </label>
        <input
          type="text"
          id="modal-colegio"
          name="colegio"
          required
          class="w-full px-4 py-3 rounded-lg border border-neutral-200 focus:border-primary-600 focus:ring-2 focus:ring-primary-600/20 transition-all outline-none"
          placeholder="Colegio..."
        />
      </div>

      <!-- Comuna/Región -->
      <div>
        <label for="modal-comuna" class="block text-sm font-medium text-neutral-700 mb-1.5">
          Comuna y Región <span class="text-rosa-500">*</span>
        </label>
        <input
          type="text"
          id="modal-comuna"
          name="comuna_region"
          required
          class="w-full px-4 py-3 rounded-lg border border-neutral-200 focus:border-primary-600 focus:ring-2 focus:ring-primary-600/20 transition-all outline-none"
          placeholder="Ej: Providencia, Región Metropolitana"
        />
      </div>

      <!-- Número de alumnos -->
      <div>
        <label for="modal-alumnos" class="block text-sm font-medium text-neutral-700 mb-1.5">
          Cantidad de alumnos
        </label>
        <select
          id="modal-alumnos"
          name="num_alumnos"
          class="w-full px-4 py-3 rounded-lg border border-neutral-200 focus:border-primary-600 focus:ring-2 focus:ring-primary-600/20 transition-all outline-none bg-white"
        >
          <option value="">Seleccionar...</option>
          <option value="menos-100">Menos de 100</option>
          <option value="100-300">100 a 300</option>
          <option value="300-500">300 a 500</option>
          <option value="500-1000">500 a 1000</option>
          <option value="mas-1000">Más de 1000</option>
        </select>
      </div>

      <!-- Áreas de interés -->
      <div>
        <label class="block text-sm font-medium text-neutral-700 mb-2">
          Áreas de interés
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <label class="flex items-center gap-2 p-3 rounded-lg border border-neutral-200 hover:border-primary-400 cursor-pointer transition-colors">
            <input type="checkbox" name="area_interes" value="liderazgo" class="w-4 h-4 text-primary-600 rounded focus:ring-primary-600" />
            <span class="text-sm text-neutral-700">Liderazgo Institucional</span>
          </label>
          <label class="flex items-center gap-2 p-3 rounded-lg border border-neutral-200 hover:border-primary-400 cursor-pointer transition-colors">
            <input type="checkbox" name="area_interes" value="pedagogica" class="w-4 h-4 text-primary-600 rounded focus:ring-primary-600" />
            <span class="text-sm text-neutral-700">Gestión Pedagógica</span>
          </label>
          <label class="flex items-center gap-2 p-3 rounded-lg border border-neutral-200 hover:border-primary-400 cursor-pointer transition-colors">
            <input type="checkbox" name="area_interes" value="convivencia" class="w-4 h-4 text-primary-600 rounded focus:ring-primary-600" />
            <span class="text-sm text-neutral-700">Formación y Convivencia</span>
          </label>
          <label class="flex items-center gap-2 p-3 rounded-lg border border-neutral-200 hover:border-primary-400 cursor-pointer transition-colors">
            <input type="checkbox" name="area_interes" value="recursos" class="w-4 h-4 text-primary-600 rounded focus:ring-primary-600" />
            <span class="text-sm text-neutral-700">Gestión de Recursos</span>
          </label>
          <label class="flex items-center gap-2 p-3 rounded-lg border border-neutral-200 hover:border-primary-400 cursor-pointer transition-colors sm:col-span-2">
            <input type="checkbox" name="area_interes" value="mentoria" class="w-4 h-4 text-primary-600 rounded focus:ring-primary-600" />
            <span class="text-sm text-neutral-700">Mentoría para Directores</span>
          </label>
        </div>
      </div>

      <!-- Submit Button -->
      <button
        type="submit"
        class="w-full py-4 px-6 bg-rosa-500 hover:bg-rosa-600 text-white font-semibold rounded-full transition-all duration-200 shadow-lg hover:shadow-xl hover:-translate-y-0.5"
      >
        Solicitar diagnóstico gratuito
      </button>
    </form>
  </div>
</div>

<script>
  // CSRF Token generation for modal
  function generateModalCSRFToken() {
    const array = new Uint8Array(32);
    crypto.getRandomValues(array);
    return Array.from(array, byte => byte.toString(16).padStart(2, '0')).join('');
  }
  
  // Set CSRF token when modal is in DOM
  const modalCsrfToken = generateModalCSRFToken();
  document.cookie = `csrf_token=${modalCsrfToken}; path=/; SameSite=Strict; Secure`;
  const modalCsrfInput = document.getElementById('modal-csrf-token');
  if (modalCsrfInput) modalCsrfInput.value = modalCsrfToken;
  
  // Set submit time
  const modalSubmitTimeInput = document.getElementById('modal-submit-time');
  if (modalSubmitTimeInput) modalSubmitTimeInput.value = Math.floor(Date.now() / 1000);

  async function handleSubmit(event: Event) {
    event.preventDefault();
    const form = event.target as HTMLFormElement;
    
    // Update submit time right before sending
    if (modalSubmitTimeInput) modalSubmitTimeInput.value = Math.floor(Date.now() / 1000);
    
    // Basic client-side validation
    const email = (form.querySelector('#modal-email') as HTMLInputElement)?.value || '';
    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    if (!emailPattern.test(email)) {
      alert('Por favor ingresa un correo electrónico válido.');
      return;
    }

    // Disable submit button
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalText = submitBtn?.textContent || '';
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'ENVIANDO...';
    }

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      const result = await response.json().catch(() => null);

      if (!response.ok || !result?.success) {
        throw new Error(result?.error || result?.message || 'No fue posible enviar tu solicitud.');
      }

      // Success - close modal and show confirmation
      const modal = document.getElementById('diagnostico-modal');
      if (modal) {
        modal.classList.remove('opacity-100', 'pointer-events-auto');
        modal.classList.add('opacity-0', 'pointer-events-none');
      }
      
      // Show success message
      alert(result.message || '¡Gracias! Tu solicitud fue enviada correctamente. Te contactaremos pronto.');
      
      // Reset form
      form.reset();
      
      // Regenerate CSRF token
      const newToken = generateModalCSRFToken();
      document.cookie = `csrf_token=${newToken}; path=/; SameSite=Strict; Secure`;
      if (modalCsrfInput) modalCsrfInput.value = newToken;
      if (modalSubmitTimeInput) modalSubmitTimeInput.value = Math.floor(Date.now() / 1000);
      
    } catch (error) {
      alert(error instanceof Error ? error.message : 'No fue posible enviar tu solicitud. Inténtalo nuevamente.');
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    }
  }

  // Close modal on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const modal = document.getElementById('diagnostico-modal');
      if (modal) {
        modal.classList.remove('opacity-100', 'pointer-events-auto');
        modal.classList.add('opacity-0', 'pointer-events-none');
      }
    }
  });

  // Expose openModal function globally
  (window as any).openDiagnosticoModal = () => {
    const modal = document.getElementById('diagnostico-modal');
    if (modal) {
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100', 'pointer-events-auto');
    }
  };
</script>
