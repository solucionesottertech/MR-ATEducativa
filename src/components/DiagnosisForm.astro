---
export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<form
  id="diagnosis-form"
  action="https://api.web3forms.com/submit"
  method="POST"
  class:list={['space-y-4', className]}
  novalidate
>
  <!-- Web3Forms Access Key -->
  <!-- CLIENTE: Reemplazar con access key real de Web3Forms -->
  <input type="hidden" name="access_key" value="WEB3FORMS_ACCESS_KEY" />
  <input type="hidden" name="subject" value="Solicitud de diagnóstico gratuito" />
  <input type="hidden" name="from_name" value="MR ATEducativa" />
  <input type="hidden" name="redirect" value="https://mr-ateducativa.cl/gracias-diagnostico" />

  <!-- Honeypot anti-spam -->
  <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

  <!-- Nombre -->
  <div>
    <label for="diag-nombre" class="block text-sm font-medium text-gray-700 mb-1">
      Nombre completo <span class="text-red-500">*</span>
    </label>
    <input
      type="text"
      id="diag-nombre"
      name="nombre"
      required
      minlength="2"
      class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors min-h-[44px]"
      placeholder="Tu nombre completo"
    />
    <p class="hidden mt-1 text-sm text-red-600" data-error="diag-nombre">Por favor ingresa tu nombre</p>
  </div>

  <!-- Email -->
  <div>
    <label for="diag-email" class="block text-sm font-medium text-gray-700 mb-1">
      Email <span class="text-red-500">*</span>
    </label>
    <input
      type="email"
      id="diag-email"
      name="email"
      required
      class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors min-h-[44px]"
      placeholder="tu@email.com"
    />
    <p class="hidden mt-1 text-sm text-red-600" data-error="diag-email">Por favor ingresa un email válido</p>
  </div>

  <!-- Teléfono -->
  <div>
    <label for="diag-telefono" class="block text-sm font-medium text-gray-700 mb-1">
      Teléfono <span class="text-red-500">*</span>
    </label>
    <input
      type="tel"
      id="diag-telefono"
      name="telefono"
      required
      class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors min-h-[44px]"
      placeholder="+56 9 1234 5678"
    />
  </div>

  <!-- Colegio -->
  <div>
    <label for="diag-colegio" class="block text-sm font-medium text-gray-700 mb-1">
      Nombre del establecimiento <span class="text-red-500">*</span>
    </label>
    <input
      type="text"
      id="diag-colegio"
      name="colegio"
      required
      class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors min-h-[44px]"
      placeholder="Nombre de tu colegio"
    />
  </div>

  <!-- Comuna/Región -->
  <div>
    <label for="diag-comuna" class="block text-sm font-medium text-gray-700 mb-1">
      Comuna / Región <span class="text-red-500">*</span>
    </label>
    <input
      type="text"
      id="diag-comuna"
      name="comuna_region"
      required
      class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors min-h-[44px]"
      placeholder="Ej: Santiago, Región Metropolitana"
    />
  </div>

  <!-- Número de alumnos -->
  <div>
    <label for="diag-alumnos" class="block text-sm font-medium text-gray-700 mb-1">
      Número aproximado de alumnos
    </label>
    <select
      id="diag-alumnos"
      name="num_alumnos"
      class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors min-h-[44px] bg-white"
    >
      <option value="">Selecciona un rango</option>
      <option value="menos-100">Menos de 100</option>
      <option value="100-300">100 - 300</option>
      <option value="300-500">300 - 500</option>
      <option value="500-1000">500 - 1000</option>
      <option value="mas-1000">Más de 1000</option>
    </select>
  </div>

  <!-- Área de interés -->
  <div>
    <fieldset>
      <legend class="block text-sm font-medium text-gray-700 mb-2">
        Áreas de interés <span class="text-red-500">*</span>
      </legend>
      <div class="space-y-2">
        <label class="flex items-center gap-3 p-3 border border-gray-200 rounded-lg hover:bg-gray-50 cursor-pointer transition-colors">
          <input type="checkbox" name="area_interes" value="liderazgo" class="w-4 h-4 text-primary-600 rounded" />
          <span class="text-gray-700">Liderazgo Institucional</span>
        </label>
        <label class="flex items-center gap-3 p-3 border border-gray-200 rounded-lg hover:bg-gray-50 cursor-pointer transition-colors">
          <input type="checkbox" name="area_interes" value="pedagogica" class="w-4 h-4 text-primary-600 rounded" />
          <span class="text-gray-700">Asesoría Pedagógica</span>
        </label>
        <label class="flex items-center gap-3 p-3 border border-gray-200 rounded-lg hover:bg-gray-50 cursor-pointer transition-colors">
          <input type="checkbox" name="area_interes" value="convivencia" class="w-4 h-4 text-primary-600 rounded" />
          <span class="text-gray-700">Convivencia Escolar</span>
        </label>
        <label class="flex items-center gap-3 p-3 border border-gray-200 rounded-lg hover:bg-gray-50 cursor-pointer transition-colors">
          <input type="checkbox" name="area_interes" value="recursos" class="w-4 h-4 text-primary-600 rounded" />
          <span class="text-gray-700">Gestión de Recursos</span>
        </label>
      </div>
    </fieldset>
    <p class="hidden mt-1 text-sm text-red-600" data-error="area_interes" aria-live="polite">Selecciona al menos un área de interés</p>
  </div>

  <!-- Submit -->
  <button
    type="submit"
    class="w-full px-6 py-3 bg-primary-600 text-white font-semibold rounded-lg hover:bg-primary-700 active:bg-primary-800 transition-colors min-h-[44px]"
    data-umami-event="form-submit"
  >
    Solicitar diagnóstico gratuito
  </button>

  <p class="text-xs text-gray-500 text-center">
    Al enviar aceptas que usemos tu información para contactarte respecto al diagnóstico.
  </p>
</form>

<script>
  // Client-side validation
  const form = document.getElementById('diagnosis-form');
  if (form) {
    form.addEventListener('submit', (e) => {
      const currentForm = e.currentTarget as HTMLFormElement;
      let isValid = true;
      const fields = [
        { id: 'diag-nombre', validate: (v) => v.length >= 2 },
        { id: 'diag-email', validate: (v) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v) },
        { id: 'diag-telefono', validate: (v) => v.length >= 8 },
        { id: 'diag-colegio', validate: (v) => v.length >= 2 },
        { id: 'diag-comuna', validate: (v) => v.length >= 2 },
      ];

      fields.forEach(({ id, validate }) => {
        const input = currentForm.querySelector(`#${id}`);
        const error = currentForm.querySelector(`[data-error="${id}"]`);
        if (input && error) {
          const value = (input as HTMLInputElement).value.trim();
          if (!validate(value)) {
            isValid = false;
            error.classList.remove('hidden');
            input.classList.add('border-red-500');
          } else {
            error.classList.add('hidden');
            input.classList.remove('border-red-500');
          }
        }
      });

      // Check at least one area is selected
      const areas = currentForm.querySelectorAll('input[name="area_interes"]:checked');
      const areaError = currentForm.querySelector('[data-error="area_interes"]');
      if (areas.length === 0) {
        isValid = false;
        if (areaError) areaError.classList.remove('hidden');
      } else {
        if (areaError) areaError.classList.add('hidden');
      }

      if (!isValid) {
        e.preventDefault();
      }
    });
  }
</script>
