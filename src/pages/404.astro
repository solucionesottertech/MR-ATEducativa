---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButton from '../components/CTAButton.astro';
---

<BaseLayout
  title="Página no encontrada | MR ATEducativa"
  description="La página que buscas no existe. Vuelve al inicio o explora nuestros servicios de asesoría educativa."
  path="/404"
  robots="noindex, follow"
>
  <section class="min-h-[60vh] flex items-center justify-center bg-neutral-50">
    <div class="container-page text-center">
      <div class="max-w-2xl mx-auto">
        <h1 class="text-6xl font-bold text-primary-700 mb-4">404</h1>
        <h2 class="heading-h2 text-neutral-900 mb-6">
          Página no encontrada
        </h2>
        <p class="body-lg text-neutral-600 mb-8">
          La página que buscas no existe o fue movida. Te ayudamos a encontrar lo que necesitas.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
          <a href="/" class="btn bg-primary-600 text-white px-6 py-3 rounded-full hover:bg-primary-700 transition-colors">
            Volver al inicio
          </a>
          <a href="/servicios" class="btn border-2 border-primary-600 text-primary-600 px-6 py-3 rounded-full hover:bg-primary-50 transition-colors">
            Ver servicios
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left">
          <a href="/servicios/liderazgo" class="block p-6 bg-white rounded-xl border border-neutral-200 hover:border-primary-300 hover:shadow-md transition-all">
            <h3 class="font-semibold text-neutral-900 mb-2">Liderazgo Institucional</h3>
            <p class="text-sm text-neutral-600">Fortalecemos a quienes lideran la mejora educativa.</p>
          </a>
          <a href="/servicios/gestion-pedagogica" class="block p-6 bg-white rounded-xl border border-neutral-200 hover:border-rosa-300 hover:shadow-md transition-all">
            <h3 class="font-semibold text-neutral-900 mb-2">Gestión Pedagógica</h3>
            <p class="text-sm text-neutral-600">Prácticas que impactan directamente en el aprendizaje.</p>
          </a>
          <a href="/contacto" class="block p-6 bg-white rounded-xl border border-neutral-200 hover:border-teal-300 hover:shadow-md transition-all">
            <h3 class="font-semibold text-neutral-900 mb-2">Contacto</h3>
            <p class="text-sm text-neutral-600">Diagnóstico gratuito de 30 minutos.</p>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
