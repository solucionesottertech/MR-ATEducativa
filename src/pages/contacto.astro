---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../data/site';

const schemaData = {
  mainEntity: [
    {
      '@type': 'Question',
      name: '¿Cuánto dura el diagnóstico gratuito?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'El diagnóstico inicial tiene una duración de 30 minutos y es completamente gratuito. Puede ser presencial en Santiago o videollamada.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Trabajan con todo tipo de establecimientos?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Sí, trabajamos con colegios municipales, particulares subvencionados y particulares pagados en todo Chile.',
      },
    },
  ],
};

const breadcrumbItems = [
  { name: 'Inicio', path: '/' },
  { name: 'Contacto', path: '/contacto' },
];
---

<BaseLayout
  title="Contacto | MR ATEducativa - Diagnóstico Gratuito"
  description="Contacta a MR ATEducativa para una asesoría técnica educativa. Diagnóstico gratuito de 30 minutos para colegios en Chile. WhatsApp: +56 9 2765 9269"
  path="/contacto"
  schema="FAQPage"
  schemaData={schemaData}
  keywords="contacto ATE, diagnóstico gratuito, asesoría educativa, WhatsApp MR ATEducativa"
  breadcrumb={breadcrumbItems}
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-primary-700 min-h-[50vh] flex items-center">

    <div class="container-page py-20 sm:py-28 relative">
      <div class="max-w-3xl text-center mx-auto">
        <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/20 backdrop-blur-sm text-white/90 text-sm font-semibold mb-4 border border-white/10">
          Contáctanos
        </span>
        <h1 class="heading-display text-white mb-6">
          Conversemos sobre las necesidades de tu comunidad educativa
        </h1>
        <p class="text-lg sm:text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          Cada establecimiento tiene desafíos, prioridades y contextos diferentes. Comenzamos escuchando y comprendiendo tu realidad.
        </p>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
        <path d="M0 120L60 108C120 96 240 72 360 66C480 60 600 72 720 78C840 84 960 84 1080 78C1200 72 1320 60 1380 54L1440 48V120H0Z" fill="#FBF9F6"/>
      </svg>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="section-padding">
    <div class="container-page">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
        <!-- Contact Form -->
        <div class="reveal">
          <div id="contact-form-wrapper" class="bg-white p-6 sm:p-8 rounded-2xl border border-neutral-200 shadow-card scroll-mt-24">
